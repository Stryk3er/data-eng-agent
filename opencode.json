{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.5-flash-lite",
  "small_model": "google/gemini-3.5-flash-lite",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "duckdb": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-duckdb",
        "--db-path",
        "./data/warehouse.duckdb",
        "--readonly"
      ],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "deny",
    "skill": {
      "*": "allow"
    }
  },
  "agent": {
    "data-engineer": {
      "description": "Operates the weather+FX pipeline: extraction, dbt, profiling, diagnosis, fix PRs. Cannot execute destructive operations -- only propose them.",
      "model": "google/gemini-3.5-flash-lite",
      "prompt": "{file:AGENTS.md}",
      "tools": {
        "run_extraction": true,
        "run_dbt": true,
        "profile_table": true,
        "diagnose_failure": true,
        "open_fix_pr": true,
        "propose_full_refresh": true
      }
    }
  },
  "default_agent": "data-engineer"
}