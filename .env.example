# Copy to .env for local runs (never commit the real .env -- gitignored).
# In GitHub Actions these are repo secrets instead, not this file.

# Banxico SIE API token -- free, no card. Request one at:
# https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# Free LLM key for the OpenCode agent. opencode.json defaults to Groq;
# swap the model string there if you use a different provider.
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Only needed for the open_fix_pr / propose_full_refresh tools running
# locally outside of GitHub Actions (where GITHUB_TOKEN is automatic).
GITHUB_TOKEN=
